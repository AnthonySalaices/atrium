# ⛔ SECRET — the glassd auth token. It is copied into the APK at build time and
# it grants read access to every agent terminal on the host. It must never be
# committed, least of all in a repo meant to be published.
/godot/data/token.txt

# Your own host address — local, so the repo carries no LAN layout.
# See godot/data/host.txt.example.
/godot/data/host.txt
/godot/data/session.txt

# Toolchain: Godot 4.7.2 + Android SDK + NDK, 3.2 GB, reproducible at pinned
# versions with tools/bootstrap-toolchain.sh.
/toolchain/

# godotopenxrvendors 5.1.0-stable (82 MB), downloaded by bootstrap at a pinned
# tag. Required for the build, not ours to vendor.
/godot/addons/

# Android build template + gradle output (1.1 GB) and the exported APK (86 MB),
# both regenerated by tools/build-apk.sh. The gradle tree also bakes absolute
# paths, so committing it would break on any move.
/godot/android/
/godot/build/

# Godot's import cache — regenerated by `godot --headless --path godot --import`.
/godot/.godot/

# Lua 5.4.7 binary, built from source by tools/build-lua.sh.
/vendor/lua/bin/

# Astra deliveries land here; they are assets, not source.
/inbox/*
!/inbox/.gitkeep

# Internal operating notes: fleet hostnames, addresses, session state and
# personal working context. The engineering content lives in docs/ instead,
# written for people who are not me.
/AGENTS.md
/CLAUDE.md
/.agents/
/HEADSET-WINDOW.md

/logs/
__pycache__/
*.pyc

# Internal: Astra briefs (owner voice, LAN links) and deliveries stay on the box.
/astra/
/inbox/*
!/inbox/.gitkeep

# Python packaging
/dist/
/build/
*.egg-info/

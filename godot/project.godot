; Engine configuration file.
config_version=5

[application]

config/name="Atrium"
run/main_scene="res://scenes/terminal.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Mobile")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
; ⛔ A failed OpenXR start otherwise pops a MODAL ALERT. On the desktop — where
; there is no HMD by definition — that dialog hangs the process waiting for a
; click nobody will make, or fails to appear and exits 1 in a scheduled-task
; context. Either way a flat run of this project never renders, which cost a long
; debugging round. The headset is unaffected: OpenXR starts fine there.
openxr/startup_alert=false
openxr/foveation_level=2
; ⚠️ godot_openxr_vendors reads THIS project setting to decide whether to inject
; the Meta hand-tracking manifest entries. Without it the export options are read
; but silently produce nothing, and every run logs
; "Property not found: 'xr/openxr/extensions/hand_tracking'".
openxr/extensions/hand_tracking=true
; Same gate as hand_tracking: without this the Meta passthrough manifest feature
; is never injected and the runtime offers ONLY the opaque blend mode — which is
; exactly what the headset reported on 2026-09-15.
openxr/extensions/meta/passthrough=true
shaders/enabled=true
